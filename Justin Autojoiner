-- ===== Connection loop =====
task.spawn(function()
    if not connect then rawLbl.Text = "Executor has no WebSocket API" return end
    while not state.dead do
        setStatus("connecting")
        local ok, ws = pcall(connect, WS_URL)
        if ok and ws then
            state.live = true
            setStatus("live")
            local closed = false
            ws.OnMessage:Connect(onMessage)
            ws.OnClose:Connect(function() closed = true end)
            while not closed and not state.dead do task.wait(1) end
            state.live = false
        end
        setStatus("offline")
        task.wait(3)
    end
end)
