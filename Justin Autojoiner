-- ===== Logic =====
local function setStatus(kind)
    local m = { live = { "Live", C.good }, connecting = { "Connecting...", C.warn }, offline = { "Offline", C.bad } }
    local s = m[kind] or m.offline
    statusLbl.Text, statusLbl.TextColor3, dot.BackgroundColor3 = s[1], s[2], s[2]
end

local function parseGen(v)
    if type(v) == "number" then return v end
    local s = tostring(v or ""):gsub("/s", "")
    s = s:gsub("[%s,%$]", "")
    local n, suf = s:match("^([%d%.]+)(%a*)$")
    n = tonumber(n)
    if not n then return 0 end
    local mult = { K = 1e3, M = 1e6, B = 1e9, T = 1e12 }
    return n * (mult[suf:upper()] or 1)
end
local function fmtGen(n)
    local u = { "", "K", "M", "B", "T" }
    local i = 1
    while n >= 1000 and i < #u do n, i = n / 1000, i + 1 end
    local s = ("%.1f"):format(n):gsub("%.0$", "")
    return s .. u[i] .. "/s"
end

local function pick(t, keys)
    for _, k in ipairs(keys) do if t[k] ~= nil then return t[k] end end
end

-- Accepts several common shapes; unknown formats still show the raw text.
local function normalize(raw)
    local out = {}
    local ok, msg = pcall(HttpService.JSONDecode, HttpService, raw)
    if ok and type(msg) == "table" then
        local items = pick(msg, { "data", "payload", "servers", "jobs", "items" }) or msg
        if type(items) ~= "table" then items = msg end
        if items[1] == nil then items = { items } end
        for _, d in ipairs(items) do
            if type(d) == "table" then
                local jid = pick(d, { "jobId", "job_id", "JobId", "jobID", "serverId", "server_id", "id" })
                if type(jid) == "string" then
                    local name = pick(d, { "name", "brainrot", "brainrotName", "displayName", "DisplayName", "animal", "Name" })
                    if type(name) == "table" then name = name[1] end
                    out[#out + 1] = { jobId = jid, name = tostring(name or "Unknown"),
                        gen = parseGen(pick(d, { "gen", "generation", "Generation", "income", "value" })),
                        ts = tonumber(pick(d, { "ts", "timestamp", "time" })) }
                end
            end
        end
    else
        local jid = tostring(raw):match("%x+%-%x+%-%x+%-%x+%-%x+")
        if jid then out[1] = { jobId = jid, name = tostring(raw):sub(1, 40), gen = 0 } end
    end
    return out
end

local function joinServer(jobId, label)
    if state.joining then return end
    state.joining = true
    statusLbl.Text = "Joining " .. (label or "server") .. "..."
    task.spawn(function()
        for _ = 1, ATTEMPTS do
            pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId, jobId, player) end)
            task.wait(3)
        end
        state.joining = false
        setStatus(state.live and "live" or "offline")
    end)
end

local function addRow(d)
    state.order += 1
    local row = make("Frame", { Size = UDim2.new(1, 0, 0, 48), BackgroundColor3 = C.el, BorderSizePixel = 0,
        LayoutOrder = -state.order, Parent = list }, { corner(8) })
    make("TextLabel", { Position = UDim2.fromOffset(12, 5), Size = UDim2.new(1, -90, 0, 20), BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold, Text = d.name, TextColor3 = C.text, TextSize = 15,
        TextTruncate = Enum.TextTruncate.AtEnd, TextXAlignment = Enum.TextXAlignment.Left, Parent = row })
    local sub = make("TextLabel", { Position = UDim2.fromOffset(12, 26), Size = UDim2.new(1, -90, 0, 16), BackgroundTransparency = 1,
        Font = Enum.Font.Gotham, Text = "", TextColor3 = C.dim, TextSize = 12,
        TextTruncate = Enum.TextTruncate.AtEnd, TextXAlignment = Enum.TextXAlignment.Left, Parent = row })
    local born = os.clock()
    task.spawn(function()
        while row.Parent do
            sub.Text = ("%s  ·  %ds  ·  %s"):format(d.gen > 0 and fmtGen(d.gen) or "?", math.floor(os.clock() - born), d.jobId:sub(1, 8))
            task.wait(1)
        end
    end)
    local jb = button(row, "JOIN", UDim2.new(1, -66, 0.5, -14), UDim2.fromOffset(58, 28), C.good)
    jb.TextColor3 = Color3.fromRGB(16, 24, 18)
    jb.MouseButton1Click:Connect(function() joinServer(d.jobId, d.name) end)

    table.insert(state.rows, row)
    while #state.rows > MAX_ROWS do table.remove(state.rows, 1):Destroy() end
end

local function onMessage(raw)
    rawLbl.Text = "Last message: " .. tostring(raw):gsub("%s+", " ")
    for _, d in ipairs(normalize(raw)) do
        local last = state.seen[d.jobId]
        if not last or os.clock() - last > 60 then
            state.seen[d.jobId] = os.clock()
            addRow(d)
            local fresh = not d.ts or (os.time() - d.ts) <= MAX_AGE
            if state.autoJoin and fresh and d.gen >= parseGen(minBox.Text) and d.jobId ~= game.JobId then
                joinServer(d.jobId, d.name)
            end
        end
    end
end

